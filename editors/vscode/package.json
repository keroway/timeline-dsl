{
  "name": "timeline-dsl",
  "displayName": "Timeline DSL",
  "description": "Syntax highlighting for Timeline DSL (.tdsl) files — a DSL for building timelines with Wikidata integration",
  "version": "1.19.0",
  "publisher": "keroway",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "timeline",
    "dsl",
    "wikidata",
    "history",
    "tdsl"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keroway/timeline-dsl"
  },
  "bugs": {
    "url": "https://github.com/keroway/timeline-dsl/issues"
  },
  "homepage": "https://github.com/keroway/timeline-dsl#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tdsl"
  ],
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tdsl",
        "aliases": [
          "Timeline DSL",
          "tdsl"
        ],
        "extensions": [
          ".tdsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tdsl",
        "scopeName": "source.tdsl",
        "path": "./syntaxes/tdsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tdsl",
        "path": "./snippets/tdsl.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Timeline DSL",
      "properties": {
        "timelineDsl.serverPath": {
          "type": "string",
          "default": "",
          "description": "`tdsl` バイナリへの絶対パス。空の場合は PATH から `tdsl` を解決する。"
        }
      }
    }
  }
}
