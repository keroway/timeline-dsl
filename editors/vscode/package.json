{
  "name": "timeline-dsl",
  "displayName": "Timeline DSL",
  "description": "Syntax highlighting for Timeline DSL (.tdsl) files — a DSL for building timelines with Wikidata integration",
  "version": "2.0.0",
  "publisher": "keroway",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "timeline",
    "dsl",
    "wikidata",
    "history",
    "tdsl"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keroway/timeline-dsl"
  },
  "bugs": {
    "url": "https://github.com/keroway/timeline-dsl/issues"
  },
  "homepage": "https://github.com/keroway/timeline-dsl#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tdsl"
  ],
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "tdsl",
        "aliases": [
          "Timeline DSL",
          "tdsl"
        ],
        "extensions": [
          ".tdsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tdsl",
        "scopeName": "source.tdsl",
        "path": "./syntaxes/tdsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tdsl",
        "path": "./snippets/tdsl.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Timeline DSL",
      "properties": {
        "timelineDsl.serverPath": {
          "type": "string",
          "default": "",
          "description": "`tdsl` バイナリへの絶対パス。空の場合は PATH から `tdsl` を解決する。"
        },
        "timelineDsl.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Language Server との通信をトレースする（不具合報告時のログ取得用）。"
        }
      }
    },
    "commands": [
      {
        "command": "timelineDsl.openPreview",
        "title": "Timeline DSL: Open Preview to the Side",
        "category": "Timeline DSL"
      },
      {
        "command": "timelineDsl.restartServer",
        "title": "Timeline DSL: Restart Language Server",
        "category": "Timeline DSL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "timelineDsl.openPreview",
          "when": "editorLangId == tdsl"
        }
      ]
    }
  }
}
